# Database Configuration
# PostgreSQL (production)
# DATABASE_URL=postgresql://attendance_user:attendance_pass@localhost:5432/attendance_db

# SQLite (for testing - avtomatik ishlaydi)
DATABASE_URL=sqlite:///./attendance.db

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ISUP_HOST=0.0.0.0
ISUP_PORT=7660

# Device Configuration
DEFAULT_DEVICE_USERNAME=admin
DEFAULT_DEVICE_PASSWORD=

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Terminal Settings
TERMINAL_TIMEOUT=30
MAX_CONNECTIONS=100

# File Storage
FACE_IMAGE_PATH=data/faces
TEMP_DATA_PATH=data/temp

# Notification Settings (future use)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
SMS_API_KEY=
SMS_API_URL=

# Multi-branch Configuration
DEFAULT_BRANCH_CODE=HQ001
